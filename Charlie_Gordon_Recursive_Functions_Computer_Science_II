def factorial(n):
    #If the number is 0
    if n == 0:
        return 1
    #Else do the number times (one less itself until it reaches 0)
    return n * factorial(n-1)
def summation(n):
    #If the number is great than 0
    if n > 0:
        #Do the number plus itself until it reaches 0
        return n +summation(n-1)
    #If its 0
    if n == 0:
        return 0
def powers(a, n):
    if n > 0:
        #Multiply by itself until n has run out
        return a*powers(a, n-1)
    if n == 0:
        return 1
def sum_of_num_digits(n):
    #If single didfit
    if n < 10:
        return n
    else:
        #Add up all digits
        return sum_of_num_digits(n//10) + n%10
def fibbonaci(n):
    if n==0:
        return 0
    if n == 1:
        return 1
    #Add n-1 and n-2 until n = 1 or 0
    return fibbonaci(n-1) + fibbonaci(n-2)
def compound_int(p,r,t):
    if t == 0:
        return p
    if t > 0:
        #* the percentage to n however many time t says
        return (1+r) * compound_int(p,r,t-1)
def prod_of_2_whole_numbers(a,b):
    if b > 0:
        #Add a to itself b times
        return a+prod_of_2_whole_numbers(a,b-1)
    elif b == 0:
        return 0
